generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  tier          String         @default("standard")
  createdAt     DateTime       @default(now())
  users         User[]
  businessUnits BusinessUnit[]
  roles         Role[]
  clusters      Cluster[]
  accounts      OrgAccount[]
  programs      Program[]
  artifactTemplates ArtifactTemplate[]
}

model BusinessUnit {
  id       String       @id @default(cuid())
  orgId    String
  name     String
  org      Organization @relation(fields: [orgId], references: [id])
  projects Project[]
}

model Role {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  permissions Json
  org         Organization @relation(fields: [orgId], references: [id])
  users       User[]
}

model User {
  id            String    @id @default(cuid())
  orgId         String
  uid           String?   @unique  // AD/org key — alphanumeric ≤10; nullable for backfill; app-validated /^[A-Za-z0-9]{1,10}$/
  email         String    @unique
  fullName      String
  passwordHash  String?
  role          String    @default("pm")
  roleId        String?
  status        String    @default("active")
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  emailVerified DateTime?
  approved      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  org                    Organization              @relation(fields: [orgId], references: [id])
  roleRef                Role?                     @relation(fields: [roleId], references: [id])
  ownedProjects          Project[]                 @relation("PMOwner")
  oauthAccounts          Account[]
  sessions               Session[]
  artifactVersions       ArtifactVersion[]
  reqDocs                RequirementsDocument[]
  artifactSelections     ArtifactSelection[]
  invitations            Invitation[]
  programAssignments     ProgramAssignment[]
  accountAssignments     AccountAssignment[]
  clusterAssignments     ClusterAssignment[]
  projectPmAssignments   ProjectPmAssignment[]
  escalationsRaised        Escalation[]              @relation("EscalationRaisedBy")
  escalationsOwned         Escalation[]              @relation("EscalationOwner")
  escalationsAcknowledged  Escalation[]              @relation("EscalationAcknowledgedBy")
  escalationsResolved      Escalation[]              @relation("EscalationResolvedBy")
  escalationComments       EscalationComment[]
  notificationPreference   NotificationPreference?
  copilotEnabled         Boolean                   @default(false)
  assistantName          String                    @default("Copilot")
  assistantConversations AssistantConversation[]
  raisedActionItems      ActionItem[]              @relation("ActionItemRaisedBy")
  assignedActionItems    ActionItem[]              @relation("ActionItemAssignedTo")
  closedActionItems      ActionItem[]              @relation("ActionItemClosedBy")
  actionItemEvents       ActionItemEvent[]
  dmReviewNotes          DmReviewNote[]
  projectRoleAssignments ProjectRoleAssignment[]
}

// NextAuth OAuth provider accounts (credentials-based auth uses this table too)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cluster {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  code        String    @unique
  type        String    @default("geography")
  clusterLead String?
  description String?
  status      String    @default("active")
  primaryDhId String?   // denormalised — FK to User (role=dh); kept in sync with ClusterAssignment.isPrimary
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  org                Organization       @relation(fields: [orgId], references: [id])
  accounts           OrgAccount[]
  clusterAssignments ClusterAssignment[]
  projects           Project[]

  @@unique([orgId, name])
}

// DH ↔ Cluster many-to-many; exactly one row per cluster may have isPrimary=true
model ClusterAssignment {
  id         String   @id @default(cuid())
  clusterId  String
  userId     String
  isPrimary  Boolean  @default(false)
  assignedBy String?
  assignedAt DateTime @default(now())

  cluster Cluster @relation(fields: [clusterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([clusterId, userId])
  @@index([clusterId, isPrimary])
  @@map("cluster_assignments")
}

// Business Account (UST customer) — formerly "Client"; presented as "Account" in all UI/API
model OrgAccount {
  id           String    @id @default(cuid())
  orgId        String
  clusterId    String
  name         String
  code         String    @unique
  industry     String?
  region       String    @default("other")
  accountOwner String?
  status       String    @default("active")
  primaryDmId  String?   // denormalised — FK to User (role=dm); kept in sync with AccountAssignment.isPrimary
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  org               Organization       @relation(fields: [orgId], references: [id])
  cluster           Cluster            @relation(fields: [clusterId], references: [id])
  programs          Program[]
  projects          Project[]
  dmAssignments     AccountAssignment[]
  artifactTemplates ArtifactTemplate[]

  @@unique([orgId, name])
  @@map("org_accounts")
}

// DM ↔ Account many-to-many; exactly one row per account may have isPrimary=true
model AccountAssignment {
  id         String   @id @default(cuid())
  accountId  String
  userId     String
  isPrimary  Boolean  @default(false)
  assignedBy String?
  assignedAt DateTime @default(now())

  account OrgAccount @relation(fields: [accountId], references: [id])
  user    User       @relation(fields: [userId], references: [id])

  @@unique([accountId, userId])
  @@index([accountId, isPrimary])
  @@map("account_assignments")
}

model Program {
  id          String    @id @default(cuid())
  orgId       String
  accountId   String    // mandatory — programs always belong to an account (C6)
  name        String
  code        String    @unique
  description String?
  sponsor     String?
  status      String    @default("active")
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Agile defaults (Phase A)
  defaultDeliveryMethod  String?
  defaultCommercialModel String?
  defaultRateCardId      String?
  pmMarginVisibility     Boolean @default(true)

  org         Organization        @relation(fields: [orgId], references: [id])
  account     OrgAccount          @relation(fields: [accountId], references: [id])
  assignments ProgramAssignment[]
  projects    Project[]

  @@unique([orgId, name])
}

model ProgramAssignment {
  id         String   @id @default(cuid())
  programId  String
  userId     String
  assignedBy String?
  assignedAt DateTime @default(now())

  program Program @relation(fields: [programId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([programId, userId])
}

// ClientAssignment retired — replaced by AccountAssignment and ClusterAssignment (CR-01)

model Invitation {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Project {
  id                    String    @id @default(cuid())
  orgId                 String
  buId                  String?
  clusterId             String?   // denormalised from account.clusterId; mandatory at creation (C8)
  accountId             String?   // FK to OrgAccount; mandatory at creation (PC-4)
  programId             String?   // optional (C5) — null means direct-to-account project
  pmOwnerId             String

  // Denormalised delivery-owner cache — SOURCE OF TRUTH is AccountAssignment (DM) / ClusterAssignment (DH).
  // Re-materialised by syncProjectDeliveryOwners() whenever the account's primary DM or cluster's primary DH changes.
  deliveryManagerId     String?   // → User.id (current primary DM of the account)
  deliveryManagerUid    String?   // User.uid mirror for display / AD
  clusterHeadId         String?   // → User.id (current primary DH of the cluster)
  clusterHeadUid        String?   // User.uid mirror for display / AD
  name                  String
  code                  String
  customer              String?
  projectType           String    @default("fixed_price")
  methodology           String    @default("waterfall")
  engagementType        String    @default("application_development")  // application_development | product_development
  engagementMode        String    @default("detailed")
  externalExecutionTool String?
  industry              String?
  projectSize           String?
  budget                Float?
  currency              String    @default("USD")
  deliveryModel         String?
  teamSize              Int?
  startDate             DateTime?
  endDate               DateTime?
  status                String    @default("draft")
  currentPhase          String    @default("initiation")
  healthStatus          String    @default("green")
  description           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  // Grounding Phase 1
  evidenceReadinessScore Float?
  evidenceReadinessBand  String?

  // Agile & Commercial Model (Phase A)
  deliveryMethod         String    @default("predictive")  // predictive | agile_scrum | hybrid
  commercialModel        String    @default("fixed_price") // fixed_price | time_and_materials | capped_tm
  stage                  String?                           // s0_inception | s1_discovery | s2_sprint_loop | s3_release_close
  readinessGatePassedAt  DateTime?
  activeContractId       String?

  bu                 BusinessUnit?          @relation(fields: [buId], references: [id])
  cluster            Cluster?               @relation(fields: [clusterId], references: [id])
  account            OrgAccount?            @relation(fields: [accountId], references: [id])
  program            Program?               @relation(fields: [programId], references: [id])
  pmOwner            User                   @relation("PMOwner", fields: [pmOwnerId], references: [id])
  artifacts          Artifact[]
  risks              Risk[]
  issues             Issue[]
  changeRequests     ChangeRequest[]
  milestones         Milestone[]
  statusReports      StatusReport[]
  sprints            Sprint[]
  integrationLinks   IntegrationLink[]
  requirementsDocs   RequirementsDocument[]
  artifactSelections ArtifactSelection[]
  scheduleTasks      ScheduleTask[]
  costEntries        CostEntry[]
  resources          ProjectResource[]
  pmAssignments      ProjectPmAssignment[]
  escalations        Escalation[]
  requirements       Requirement[]
  gaps               Gap[]
  assistantConversations AssistantConversation[]
  advisories         Advisory[]
  actionItems        ActionItem[]
  decisions          Decision[]
  dmReviewNotes      DmReviewNote[]
  pmbSnapshots       PmbSnapshot[]
  comparisonRuns     ComparisonRun[]
  impactReports      ImpactReport[]
  goldEntries        ComparisonGoldEntry[]
  accuracyReports    AccuracyReport[]
  scopeBaselines     ScopeBaseline[]
  assumptions        Assumption[]
  dependencies       Dependency[]
  budgetRevisions    BudgetRevision[]

  // Agile relations (Phase A/B)
  contracts          Contract[]
  cadenceConfigs     CadenceConfig[]
  releases           Release[]
  backlogItems       BacklogItem[]
  roleAssignments    ProjectRoleAssignment[]
  costLedger         CostLedger[]
  agileMetrics         AgileMetricSnapshot[]
  ceremonies           Ceremony[]
  retrospectiveActions RetrospectiveAction[]
  impediments          Impediment[]
  commercialSnapshots  CommercialSnapshot[]

  // SA8: Distributed Task Actuals
  taskAssignments      TaskAssignment[]
  collectionCycles     CollectionCycle[]
  collectionTokens     CollectionToken[]
  taskActuals          TaskActualsLedger[]

  @@unique([orgId, code])
  @@index([deliveryManagerId])
  @@index([clusterHeadId])
}

model RequirementsDocument {
  id                   String    @id @default(cuid())
  projectId            String
  fileName             String
  fileFormat           String
  storageUri           String
  versionNumber        Int       @default(1)
  supersedesId         String?
  extractedContent     Json?
  extractionConfidence Float?
  ocrApplied           Boolean   @default(false)
  pmConfirmed          Boolean   @default(false)
  uploadedById         String
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?

  // Grounding Phase 1 additions
  docClass            String    @default("other")
  effectiveDate       DateTime?
  confidentialityTier String    @default("standard")
  ingestionState      String    @default("ready")
  chunkCount          Int       @default(0)

  project      Project                @relation(fields: [projectId], references: [id])
  uploadedBy   User                   @relation(fields: [uploadedById], references: [id])
  supersedes   RequirementsDocument?  @relation("Versions", fields: [supersedesId], references: [id])
  supersededBy RequirementsDocument[] @relation("Versions")
  artifacts    Artifact[]
  chunks       DocumentChunk[]
}

model DocumentChunk {
  id           String   @id @default(cuid())
  documentId   String
  projectId    String
  chunkIndex   Int
  pageNumber   Int?
  charStart    Int?
  charEnd      Int?
  sectionTitle String?
  text         String
  tokenCount   Int?
  createdAt    DateTime @default(now())

  document     RequirementsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requirements Requirement[]

  @@unique([documentId, chunkIndex])
  @@index([projectId])
  @@index([documentId])
}

model Requirement {
  id                String    @id @default(cuid())
  projectId         String
  requirementKey    String
  statement         String
  type              String    @default("functional")
  category          String?
  source            String    @default("extracted")
  status            String    @default("proposed")
  confidence        Float?
  sourceChunkId     String?
  sourceDocId       String?
  sourceQuote       String?
  confirmedById     String?
  confirmedAt       DateTime?
  amendedStatement  String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceChunk DocumentChunk? @relation(fields: [sourceChunkId], references: [id])

  @@unique([projectId, requirementKey])
  @@index([projectId])
  @@index([status])
  @@index([projectId, isActive])
}

model Gap {
  id           String    @id @default(cuid())
  projectId    String
  artifactId   String?
  artifactType String?
  fieldId      String
  question     String
  material     Boolean   @default(true)
  status       String    @default("open")
  answer       String?
  answeredBy   String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifact Artifact? @relation(fields: [artifactId], references: [id])

  @@index([projectId])
  @@index([artifactId])
  @@index([status])
}

model ArtifactSelection {
  id              String    @id @default(cuid())
  projectId       String
  artifactType    String
  selectionStatus String    @default("available")
  selectedById    String?
  sourceReqId     String?
  selectedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id])
  selectedBy User?   @relation(fields: [selectedById], references: [id])

  @@unique([projectId, artifactType])
}

model Artifact {
  id                String   @id @default(cuid())
  projectId         String
  artifactType      String
  phase             String
  status            String   @default("draft")
  currentVersion    Int      @default(1)
  sourceReqId       String?
  scopeBaselineId   String?
  content           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Grounding Phase 2
  gapCount          Int      @default(0)
  groundingScore    Float?

  project        Project               @relation(fields: [projectId], references: [id])
  sourceReq      RequirementsDocument? @relation(fields: [sourceReqId], references: [id])
  scopeBaseline  ScopeBaseline?        @relation(fields: [scopeBaselineId], references: [id])
  versions       ArtifactVersion[]
  gaps           Gap[]
}

model ArtifactVersion {
  id                  String   @id @default(cuid())
  artifactId          String
  versionNumber       Int
  content             Json
  contentHash         String?
  source              String   // ai_generated | ai_regenerated | pm_upload | restore
  approvalStatus      String   @default("unreviewed")
  parentVersionId     String?
  supersededReason    String?
  generationInputsRef Json?
  extractionStatus    String   @default("pending") // pending | complete | partial | failed
  extractionCoverage  Float?
  editedById          String?
  appliedTemplateId   String?  // FK to ArtifactTemplate — set when a custom template was used
  createdAt           DateTime @default(now())

  artifact      Artifact         @relation(fields: [artifactId], references: [id])
  editedBy      User?            @relation(fields: [editedById], references: [id])
  parentVersion ArtifactVersion? @relation("VersionLineage", fields: [parentVersionId], references: [id])
  childVersions ArtifactVersion[] @relation("VersionLineage")
  items         ArtifactVersionItem[]
  snapshotMembers PmbSnapshotMember[]

  @@unique([artifactId, versionNumber])
  @@index([artifactId, approvalStatus])
}

// ── BL-P3: PMB Snapshots ──────────────────────────────────────────────────────

model PmbSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  snapshotNumber  Int
  label           String
  trigger         String   @default("ad_hoc") // gate_approved | ad_hoc | auto_eom
  isCurrent       Boolean  @default(false)
  baselinedAt     DateTime @default(now())
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())

  project  Project              @relation(fields: [projectId], references: [id])
  members  PmbSnapshotMember[]

  @@unique([projectId, snapshotNumber])
  @@index([projectId, isCurrent])
  @@map("pmb_snapshots")
}

model PmbSnapshotMember {
  id                String   @id @default(cuid())
  snapshotId        String
  artifactVersionId String
  artifactType      String
  dimension         String   // scope | schedule | cost | context
  isRequired        Boolean  @default(false)
  createdAt         DateTime @default(now())

  snapshot        PmbSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  artifactVersion ArtifactVersion @relation(fields: [artifactVersionId], references: [id])

  @@unique([snapshotId, artifactVersionId])
  @@index([snapshotId])
  @@map("pmb_snapshot_members")
}

// ── BL-P7: Accuracy Hardening ─────────────────────────────────────────────────

model ComparisonGoldEntry {
  id                    String   @id @default(cuid())
  projectId             String
  artifactType          String
  leftItemTitle         String
  rightItemTitle        String?
  expectedMatchDecision String   // match | no_match
  expectedTemporalClass String?  // ADDED | UNCHANGED | MODIFIED | DELETED
  notes                 String?
  createdById           String?
  createdAt             DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId, artifactType])
  @@map("comparison_gold_entries")
}

model AccuracyReport {
  id             String   @id @default(cuid())
  runId          String   @unique
  projectId      String
  goldEntryCount Int      @default(0)
  truePositives  Int      @default(0)
  falsePositives Int      @default(0)
  falseNegatives Int      @default(0)
  precision      Float?
  recall         Float?
  f1Score        Float?
  computedAt     DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id])
  run     ComparisonRun @relation(fields: [runId], references: [id])

  @@map("accuracy_reports")
}

// ── BL-P5: Impact Reports ─────────────────────────────────────────────────────

model ImpactReport {
  id           String   @id @default(cuid())
  runId        String   @unique
  projectId    String
  scopeScore   Float?   // 0–1: proportion of scope items changed
  scheduleScore Float?  // 0–1: proportion of milestone items changed
  costScore    Float?   // 0–1: proportion of cost items changed
  overallRisk  String   @default("low") // low | medium | high | critical
  confidence   Float?   // 0–1: extraction coverage × match quality
  findings     Json     @default("[]")  // structured finding objects
  createdAt    DateTime @default(now())

  run     ComparisonRun @relation(fields: [runId], references: [id])
  project Project       @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("impact_reports")
}

// ── BL-P4: Comparison Engine ──────────────────────────────────────────────────

model ComparisonRun {
  id               String   @id @default(cuid())
  projectId        String
  leftVersionId    String
  rightVersionId   String
  artifactType     String
  status           String   @default("complete") // pending | complete | failed
  matchedCount     Int      @default(0)
  addedCount       Int      @default(0)
  deletedCount     Int      @default(0)
  modifiedCount    Int      @default(0)
  unchangedCount   Int      @default(0)
  createdAt        DateTime @default(now())

  project        Project         @relation(fields: [projectId], references: [id])
  pairs          ComparisonPair[]
  impactReport   ImpactReport?
  accuracyReport AccuracyReport?

  @@index([projectId, artifactType])
  @@map("comparison_runs")
}

model ComparisonPair {
  id               String    @id @default(cuid())
  runId            String
  leftItemId       String?
  rightItemId      String?
  matchTier        Int?      // 1=exact_id | 2=norm_title | 3=fuzzy | 4=position | null=unmatched
  temporalClass    String    // ADDED | UNCHANGED | MODIFIED | DELETED
  dispositionClass String?
  similarity       Float?
  overrideBy       String?
  overrideAt       DateTime?
  overrideReason   String?
  createdAt        DateTime  @default(now())

  run       ComparisonRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  leftItem  ArtifactVersionItem? @relation("LeftItem",  fields: [leftItemId],  references: [id])
  rightItem ArtifactVersionItem? @relation("RightItem", fields: [rightItemId], references: [id])

  @@index([runId])
  @@map("comparison_pairs")
}

model ArtifactVersionItem {
  id                  String   @id @default(cuid())
  artifactVersionId   String
  declaredId          String?
  sequence            Int
  sourceRef           Json
  rawText             String
  normalizedTitle     String
  normalizedDesc      String   @default("")
  entryTimestamp      DateTime?
  attributes          Json     @default("{}")
  lineageItemId       String?
  createdAt           DateTime @default(now())

  artifactVersion ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  leftPairs       ComparisonPair[] @relation("LeftItem")
  rightPairs      ComparisonPair[] @relation("RightItem")

  @@index([artifactVersionId])
  @@index([artifactVersionId, declaredId])
  @@map("artifact_version_items")
}

model Risk {
  id          String    @id @default(cuid())
  projectId   String
  riskId      String?
  description String
  category    String?
  probability String    @default("medium")
  impact      String    @default("medium")
  status      String    @default("open")
  owner          String?
  mitigation     String?
  dueDate        DateTime?
  requirementRef String?   @default("General")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id])
  escalations Escalation[]
}

model Issue {
  id          String    @id @default(cuid())
  projectId   String
  issueId     String?
  description String
  severity    String    @default("medium")
  status      String    @default("open")
  owner       String?
  resolution  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model Decision {
  id          String    @id @default(cuid())
  projectId   String
  decisionId  String?   // D-001, D-002 …
  title       String
  rationale   String?
  madeBy      String?
  madeAt      DateTime  @default(now())
  reviewAt    DateTime?
  status      String    @default("open")  // open | agreed | superseded
  linkedRef   String?   // free-text milestone label or CR number
  linkedType  String?   // "milestone" | "cr"
  sprintId    String?   // agile: sprint ID (no FK — avoids back-relation noise)
  sprintLabel String?   // agile: "Sprint 6" — denormalised for display
  category    String?   // Architecture | Scope | Process | Tooling | Team | Other
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId, status])
  @@map("decisions")
}

model ChangeRequest {
  id                 String   @id @default(cuid())
  projectId          String
  crId               String?
  title              String?
  description        String
  impactAnalysis     String?
  approvalStatus     String   @default("pending")
  budgetImpact       Decimal? @default(0)
  scheduleImpactDays Int?     @default(0)
  requestedBy        String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id])
  budgetRevisions BudgetRevision[]

  @@index([projectId])
  @@map("change_requests")
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime
  status    String   @default("pending")
  notes     String?

  project Project @relation(fields: [projectId], references: [id])
}

model StatusReport {
  id          String    @id @default(cuid())
  projectId   String
  reportDate  DateTime  @default(now())
  ragStatus   String    @default("green")
  aiSummary   String?
  rawInput    Json?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  violations  Json?

  project     Project      @relation(fields: [projectId], references: [id])
  healthScore HealthScore?
}

model HealthScore {
  id             String   @id @default(cuid())
  statusReportId String   @unique
  spi            Float?
  cpi            Float?
  riskExposure   Float?
  teamHealth     Float?
  compositeScore Float?
  ragStatus      String?
  createdAt      DateTime @default(now())

  statusReport StatusReport @relation(fields: [statusReportId], references: [id])
}

model Sprint {
  id           String    @id @default(cuid())
  projectId    String
  sprintNumber Int
  startDate    DateTime
  endDate      DateTime
  goal         String?
  status       String    @default("planned")

  // Full Agile spec (Phase B)
  label                  String?
  releaseId              String?
  cadenceConfigId        String?
  plannedCapacityPoints  Float?
  committedPoints        Float?
  acceptedPoints         Float?
  carriedPoints          Float?
  availableDays          Float?
  focusFactor            Float?
  state                  String    @default("planned") // planned | active | closed
  goalMet                String?   // yes | partial | no
  closedAt               DateTime?
  closedBy               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project              Project               @relation(fields: [projectId], references: [id])
  release              Release?              @relation(fields: [releaseId], references: [id])
  cadenceConfig        CadenceConfig?        @relation(fields: [cadenceConfigId], references: [id])
  backlogItems         BacklogItem[]
  ceremonies           Ceremony[]
  retrospectiveActions RetrospectiveAction[]
  agileMetrics         AgileMetricSnapshot[]
  impediments          Impediment[]
  costLedger           CostLedger[]
  commercialSnapshots  CommercialSnapshot[]
}

model BacklogItem {
  id          String   @id @default(cuid())
  projectId   String
  sprintId    String?  // nullable — items live in backlog without a sprint
  title       String
  type        String   @default("story")
  storyPoints Int?
  status      String   @default("todo")
  assignee    String?

  // Full Agile spec (Phase B)
  parentId              String?
  level                 String   @default("story")   // epic | feature | story | task
  itemType              String   @default("story")   // story | defect | spike | enabler | chore
  externalRef           String?
  externalUrl           String?
  description           String?
  acceptanceCriteria    String?
  points                Float?
  baselinePoints        Float?   // frozen at Readiness Gate
  inContractedBaseline  Boolean  @default(false)
  changeRequestId       String?
  disposition           String   @default("in_scope") // in_scope | deferred | out_of_scope | conditional | illustrative | negated | undetermined
  priorityRank          Float?
  state                 String   @default("todo")   // todo | in_progress | blocked | review | done
  acceptedAt            DateTime?
  acceptedBy            String?
  dorPassed             Boolean  @default(false)
  dodPassed             Boolean  @default(false)
  wbsWorkPackageId      String?
  sourceProvenance      Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project  Project              @relation(fields: [projectId], references: [id])
  sprint   Sprint?              @relation(fields: [sprintId], references: [id])
  parent   BacklogItem?         @relation("BacklogHierarchy", fields: [parentId], references: [id])
  children BacklogItem[]        @relation("BacklogHierarchy")
  history  BacklogItemHistory[]
}

model BacklogItemHistory {
  id             String   @id @default(cuid())
  backlogItemId  String
  field          String
  oldValue       String?
  newValue       String?
  changeClass    String   // reprioritise | reestimate | scope_add | scope_remove | buffer_draw | cr
  sprintId       String?
  changedBy      String
  changedAt      DateTime @default(now())

  backlogItem BacklogItem @relation(fields: [backlogItemId], references: [id])
}

// ── Agile models (Phase A) ─────────────────────────────────────────────────────

model Contract {
  id                   String    @id @default(cuid())
  projectId            String
  version              Int       @default(1)
  amendmentOf          String?
  commercialModel      String    // fixed_price | time_and_materials | capped_tm
  currency             String    @default("AUD")
  contractValue        Float?
  ceilingValue         Float?
  estimatedValue       Float?
  targetMarginPct      Float?
  rateCardId           String?
  approvedHours        Float?
  bufferPoints         Float?
  bufferValue          Float?
  invoicingTrigger     String    @default("milestone_acceptance")
  revenueRecognition   String    @default("percent_complete")
  defectEarningPolicy  String    @default("non_earning")
  paymentTermsDays     Int       @default(30)
  contractStart        DateTime?
  contractEnd          DateTime?
  baselinedAt          DateTime?
  status               String    @default("draft") // draft | baselined | amended | closed
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id])
  rateCard RateCard? @relation(fields: [rateCardId], references: [id])
}

model RateCard {
  id         String   @id @default(cuid())
  scopeLevel String   @default("program") // global | cluster | client | program | project
  scopeId    String?
  name       String
  status     String   @default("active")
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines     RateCardLine[]
  contracts Contract[]
}

model RateCardLine {
  id           String   @id @default(cuid())
  rateCardId   String
  role         String
  location     String   @default("offshore") // onshore | offshore | nearshore
  billRate     Float
  costRate     Float
  unit         String   @default("day") // hour | day
  effectiveFrom DateTime @default(now())
  effectiveTo  DateTime?
  createdAt    DateTime  @default(now())

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
}

model CostLedger {
  id          String   @id @default(cuid())
  projectId   String
  sprintId    String?
  periodStart DateTime
  periodEnd   DateTime
  source      String   @default("manual") // timesheet | manual | allocation
  role        String?
  location    String?
  hours       Float?
  costRate    Float?
  billRate    Float?
  costAmount  Float?
  billAmount  Float?
  approved    Boolean  @default(false)
  reconciled  Boolean  @default(false)
  externalRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  sprint  Sprint? @relation(fields: [sprintId], references: [id])
}

model ProjectRoleAssignment {
  id         String    @id @default(cuid())
  projectId  String
  userId     String
  role       String    // product_owner | scrum_master
  assignedBy String?
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId, role])
}

// ── Cadence & Sprint models (Phase B) ─────────────────────────────────────────

model CadenceConfig {
  id                String    @id @default(cuid())
  projectId         String
  sprintLengthWeeks Int       @default(2)
  cadenceStart      DateTime?
  holidays          Json      @default("[]")
  defaultCapacity   Float?
  notes             String?
  createdAt         DateTime  @default(now())

  project Project  @relation(fields: [projectId], references: [id])
  sprints Sprint[]
}

model Release {
  id                  String    @id @default(cuid())
  projectId           String
  number              Int
  name                String?
  goal                String?
  startSprintId       String?
  endSprintId         String?
  plannedDate         DateTime?
  actualDate          DateTime?
  isInvoicingTrigger  Boolean   @default(false)
  gateStatus          String    @default("open") // open | passed | failed
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project             Project              @relation(fields: [projectId], references: [id])
  sprints             Sprint[]
  commercialSnapshots CommercialSnapshot[]
}

model Ceremony {
  id              String    @id @default(cuid())
  projectId       String
  sprintId        String?   // optional — ceremony may not be tied to a specific sprint
  type            String    // planning | daily | review | retrospective | refinement
  scheduledAt     DateTime? // optional — may be TBD at creation time
  heldAt          DateTime?
  durationMinutes Int?
  attendancePct   Float?
  outcomeSummary  String?
  artifactId      String?
  createdAt       DateTime  @default(now())

  project Project  @relation(fields: [projectId], references: [id])
  sprint  Sprint?  @relation(fields: [sprintId], references: [id])
}

model RetrospectiveAction {
  id          String    @id @default(cuid())
  projectId   String
  sprintId    String
  description String
  ownerUserId String?
  dueSprint   String?
  status      String    @default("open") // open | in_progress | done | dropped
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id])
  sprint  Sprint  @relation(fields: [sprintId], references: [id])
}

model Impediment {
  id             String    @id @default(cuid())
  projectId      String
  sprintId       String?
  title          String    // primary label shown in the UI
  description    String?   // optional longer description
  raisedAt       DateTime  @default(now())
  raisedBy       String?
  severity       String    @default("medium") // low | medium | high | critical
  escalatedTo    String?
  escalatedAt    DateTime?
  status         String    @default("open") // open | escalated | resolved
  resolvedAt     DateTime?
  resolution     String?
  createdAt      DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])
  sprint  Sprint? @relation(fields: [sprintId], references: [id])
}

model AgileMetricSnapshot {
  id                    String   @id @default(cuid())
  projectId             String
  sprintId              String
  velocity              Float?
  trailingVelocity      Float?
  commitmentReliability Float?
  carryOverRate         Float?
  predictabilityIndex   Float?
  cycleTimeMedian       Float?
  leadTimeMedian        Float?
  throughput            Int?
  wipAvg                Float?
  escapedDefectRate     Float?
  defectDensity         Float?
  backlogReadySprints   Float?
  createdAt             DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  sprint  Sprint  @relation(fields: [sprintId], references: [id])
}

model CommercialSnapshot {
  id                       String    @id @default(cuid())
  projectId                String
  sprintId                 String?
  releaseId                String?
  snapshotAt               DateTime  @default(now())
  bac                      Float?
  pv                       Float?
  ev                       Float?
  ac                       Float?
  sv                       Float?
  cv                       Float?
  spi                      Float?
  cpi                      Float?
  burnRate                 Float?
  runwaySprints            Float?
  budgetConsumedPct        Float?
  ceilingForecastDate      DateTime?
  bufferConsumedPoints     Float?
  bufferConsumedValue      Float?
  scopeCreepIndex          Float?
  actualCostPerPoint       Float?
  baselineCostPerPoint     Float?
  eac                      Float?
  vac                      Float?
  forecastMarginPct        Float?
  computedBy               String?
  inputsHash               String?
  createdAt                DateTime  @default(now())

  project Project  @relation(fields: [projectId], references: [id])
  sprint  Sprint?  @relation(fields: [sprintId], references: [id])
  release Release? @relation(fields: [releaseId], references: [id])
}

model IntegrationLink {
  id          String   @id @default(cuid())
  projectId   String
  provider    String
  externalRef String?
  authStatus  String   @default("pending")
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model ScheduleTask {
  id              String    @id @default(cuid())
  projectId       String
  wbsCode         String
  name            String
  phase           String
  owner           String?
  resourceId      String?
  estimatedHours  Float?
  sortOrder       Int       @default(0)
  baselineStart   DateTime
  baselineFinish  DateTime
  baselineDays    Int
  plannedCost     Float?
  actualStart     DateTime?
  actualFinish    DateTime?
  actualHours     Float?
  percentComplete Int       @default(0)
  status          String    @default("not_started")
  dependencies    Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project     Project             @relation(fields: [projectId], references: [id])
  resource    ProjectResource?    @relation(fields: [resourceId], references: [id])
  assignments TaskAssignment[]
  actuals     TaskActualsLedger[]
}

model ProjectResource {
  id            String    @id @default(cuid())
  projectId     String
  name          String
  role          String
  email         String?
  allocationPct Int       @default(100)
  startDate     DateTime?
  endDate       DateTime?
  ratePerDay    Float?
  skills        String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project             @relation(fields: [projectId], references: [id])
  scheduleTasks ScheduleTask[]
  assignments   TaskAssignment[]
  tokens        CollectionToken[]
  actuals       TaskActualsLedger[]
}

// ── SA8: Distributed Task Actuals Collection ───────────────────────────────────

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  resourceId String
  projectId  String
  role       String?  // Lead | Support | Reviewer
  createdAt  DateTime @default(now())

  task     ScheduleTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource ProjectResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id])

  @@unique([taskId, resourceId])
  @@index([projectId])
}

model CollectionCycle {
  id          String    @id @default(cuid())
  projectId   String
  cycleNumber Int
  label       String?   // e.g. "Sprint 4 actuals"
  startDate   DateTime
  endDate     DateTime
  status      String    @default("open") // open | closed | processing | complete
  taskIds     Json      @default("[]")   // specific task IDs included; empty = all tasks
  dispatchedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String?

  project Project           @relation(fields: [projectId], references: [id])
  tokens  CollectionToken[]
  actuals TaskActualsLedger[]

  @@unique([projectId, cycleNumber])
  @@index([projectId, status])
}

model CollectionToken {
  id         String    @id @default(cuid())
  cycleId    String
  resourceId String
  projectId  String
  tokenHash  String    @unique  // SHA-256 of raw 32-byte token; raw token is emailed, never stored
  expiresAt  DateTime
  usedAt     DateTime?
  status     String    @default("pending") // pending | submitted | expired
  emailSentAt DateTime?
  createdAt  DateTime  @default(now())

  cycle    CollectionCycle @relation(fields: [cycleId], references: [id])
  resource ProjectResource @relation(fields: [resourceId], references: [id])
  project  Project         @relation(fields: [projectId], references: [id])
  actuals  TaskActualsLedger[]

  @@index([cycleId])
  @@index([resourceId])
}

model TaskActualsLedger {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String
  resourceId      String
  cycleId         String
  tokenId         String

  hoursWorked     Float
  percentComplete Int
  etcHours        Float?   // Estimate To Complete
  disposition     String   // confirmed_as_planned | actual | forecast | estimated | unknown
  notes           String?

  submittedAt     DateTime @default(now())
  supersededById  String?  // points to a newer ledger entry that corrects this one

  project  Project         @relation(fields: [projectId], references: [id])
  task     ScheduleTask    @relation(fields: [taskId], references: [id])
  resource ProjectResource @relation(fields: [resourceId], references: [id])
  cycle    CollectionCycle @relation(fields: [cycleId], references: [id])
  token    CollectionToken @relation(fields: [tokenId], references: [id])

  @@index([projectId, cycleId])
  @@index([taskId, cycleId])
  @@index([tokenId])
}

model CostEntry {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime
  amount      Float
  category    String   @default("labor")
  description String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model ModelConfig {
  id          String   @id @default(cuid())
  agent       String   @unique
  model       String
  provider    String   @default("anthropic")
  maxTokens   Int      @default(8192)
  temperature Float    @default(0)
  notes       String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ── Artifact Templates ─────────────────────────────────────────────────────────
// Addendum-only overlays scoped to the org (global) or a specific client account.
// The system default prompt is always preserved — addenda are layered on top.
model ArtifactTemplate {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  description    String?
  artifactType   String   // matches ARTIFACT_CATALOG key; "all" = catch-all for every type
  scope          String   @default("global") // global | account
  accountId      String?  // null when scope=global; FK to OrgAccount when scope=account
  systemAddendum String?  // appended to PMI_SYSTEM_PROMPT (role / methodology / terminology)
  userAddendum   String?  // appended to per-type content instruction (sections / format)
  isActive       Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id])
  account OrgAccount?  @relation(fields: [accountId], references: [id])

  @@index([orgId, artifactType, scope, isActive])
}

model ProjectPmAssignment {
  id            String    @id @default(cuid())
  projectId     String
  userId        String
  assignedBy    String?
  reason        String    @default("")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  assignedAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Escalation {
  id                   String    @id @default(cuid())
  orgId                String
  targetType           String    @default("project")
  projectId            String?
  riskId               String?
  raisedById           String
  ownerId              String?
  title                String
  description          String    @default("")
  situation            String    @default("")
  impact               String    @default("")
  supportRequired      String    @default("")
  severity             String    @default("high")
  status               String    @default("open")
  slaBreachedAt        DateTime?
  slaDueAt             DateTime?
  acknowledgedById     String?
  acknowledgedAt       DateTime?
  resolvedById         String?
  resolvedAt           DateTime?
  resolutionNote       String?
  withdrawnAt          DateTime?
  withdrawalReason     String?
  targetResolutionDate DateTime?
  contextSnapshot      Json?
  dueDate              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project        Project?            @relation(fields: [projectId], references: [id])
  risk           Risk?               @relation(fields: [riskId], references: [id])
  raisedBy       User                @relation("EscalationRaisedBy", fields: [raisedById], references: [id])
  owner          User?               @relation("EscalationOwner", fields: [ownerId], references: [id])
  acknowledgedBy User?               @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id])
  resolvedBy     User?               @relation("EscalationResolvedBy", fields: [resolvedById], references: [id])
  comments       EscalationComment[]
}

model EscalationComment {
  id           String   @id @default(cuid())
  escalationId String
  userId       String
  body         String
  createdAt    DateTime @default(now())

  escalation Escalation @relation(fields: [escalationId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  escalationEmail    Boolean @default(true)
  escalationInApp    Boolean @default(true)
  statusReportEmail  Boolean @default(false)
  statusReportInApp  Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

model AssistantConversation {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  startedAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  status       String   @default("active")

  user     User               @relation(fields: [userId], references: [id])
  project  Project?           @relation(fields: [projectId], references: [id])
  messages AssistantMessage[]
  actions  AssistantAction[]
}

model AssistantAction {
  id             String    @id @default(cuid())
  conversationId String
  actionType     String
  tier           String
  payload        Json
  status         String    @default("proposed")
  confirmedAt    DateTime?
  undoneAt       DateTime?
  createdAt      DateTime  @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id])
}

model AssistantMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  tabContext     String?
  createdAt      DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id])
}

// ── Advisory Engine ────────────────────────────────────────────────────────────

model Advisory {
  id              String    @id @default(cuid())
  projectId       String
  ruleId          String    // e.g. "RA-04", "SCH-02"
  pack            String    // ra | sch | bud | iss | xar
  class           String    // c1 | c2 | c3 | c4
  severity        String    // s1 | s2 | s3 | s4
  provenance      String    @default("p1") // p1 | p3
  tab             String    // risk | schedule | cost | issues | cross
  objectType      String?   // "risk" | "task" | "issue"
  objectId        String?
  statement       String
  evidenceSummary String
  draftPayload    Json?
  state           String    @default("proposed") // proposed|accepted|deferred|dismissed|resolved
  rankScore       Float     @default(0)
  mode            String    @default("m1") // m1|m2|m3
  createdAt       DateTime  @default(now())
  stateChangedAt  DateTime?
  deferredUntil   DateTime?

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions AdvisoryAction[]

  @@index([projectId, state, severity])
  @@index([projectId, tab, state])
  @@unique([projectId, ruleId, objectId])
}

model AdvisoryAction {
  id              String   @id @default(cuid())
  advisoryId      String
  action          String   // accept|dismiss|defer|link
  dismissalReason String?
  createdAt       DateTime @default(now())

  advisory Advisory @relation(fields: [advisoryId], references: [id], onDelete: Cascade)
}

// ── Delivery Manager ───────────────────────────────────────────────────────────

model ActionItem {
  id              String    @id @default(cuid())
  reference       String    @unique  // e.g. AI-PRJ014-007
  projectId       String
  title           String
  description     String?
  category        String    @default("schedule")
  // schedule | cost | scope_change | risk | issue | quality | stakeholder
  // resource | governance | artifact | data_hygiene
  priority        String    @default("p2")
  // p1 (≤2 working days) | p2 (≤5) | p3 (≤15)
  dueDate         DateTime?
  originalDueDate DateTime?
  assignedToId    String
  raisedById      String
  source          String    @default("manual")
  // manual | status_review | gate_rejection | escalation_followup | threshold_alert
  expectedOutcome String?
  status          String    @default("open")
  // open | acknowledged | in_progress | blocked | submitted | closed | cancelled
  blockedReason   String?
  pmResponse      String?
  closedById      String?
  closureNote     String?
  acknowledgedAt  DateTime?
  submittedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    Project          @relation(fields: [projectId], references: [id])
  assignedTo User             @relation("ActionItemAssignedTo", fields: [assignedToId], references: [id])
  raisedBy   User             @relation("ActionItemRaisedBy", fields: [raisedById], references: [id])
  closedBy   User?            @relation("ActionItemClosedBy", fields: [closedById], references: [id])
  events     ActionItemEvent[]

  @@index([projectId, status])
  @@index([assignedToId, status])
  @@index([raisedById])
  @@map("action_items")
}

model ActionItemEvent {
  id           String   @id @default(cuid())
  actionItemId String
  actorId      String
  fromStatus   String
  toStatus     String
  reason       String?
  createdAt    DateTime @default(now())

  actionItem ActionItem @relation(fields: [actionItemId], references: [id])
  actor      User       @relation(fields: [actorId], references: [id])

  @@index([actionItemId])
  @@map("action_item_events")
}

model DmReviewNote {
  id          String   @id @default(cuid())
  projectId   String
  authorId    String
  reviewType  String   @default("ad_hoc")
  // weekly_review | ad_hoc | escalation_prep | gate_review | handover_review
  body        String
  visibility  String   @default("shared_with_pm")
  // shared_with_pm | dm_only
  lockedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@map("dm_review_notes")
}

// ── Scope Control ──────────────────────────────────────────────────────────────

model ScopeBaseline {
  id               String   @id @default(cuid())
  projectId        String
  version          Int
  label            String
  snapshot         Json     @default("[]")
  removedSnapshot  Json     @default("[]")
  impactSummary    Json?
  requirementCount Int      @default(0)
  deltaReviewed    Boolean  @default(false)
  createdById      String?
  createdAt        DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("scope_baselines")
}

model Assumption {
  id         String   @id @default(cuid())
  projectId  String
  statement  String
  category   String   @default("general")
  source     String   @default("manual")
  status     String   @default("open")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("assumptions")
}

model Dependency {
  id          String    @id @default(cuid())
  projectId   String
  description String
  type        String    @default("external")
  owner       String?
  dueDate     DateTime?
  status      String    @default("open")
  source      String    @default("manual")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("dependencies")
}

model BudgetRevision {
  id               String    @id @default(cuid())
  projectId        String
  changeRequestId  String?
  previousBudget   Decimal
  newBudget        Decimal
  delta            Decimal
  reason           String
  approvedById     String?
  createdAt        DateTime  @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id])

  @@index([projectId])
  @@map("budget_revisions")
}
